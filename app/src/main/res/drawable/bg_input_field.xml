<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/vault_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/vault_emerald_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/vault_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/vault_hairline" />
        </shape>
    </item>
</selector>
