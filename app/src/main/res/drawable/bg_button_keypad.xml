<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4034D399">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/vault_key_end"
                android:startColor="@color/vault_key_start" />
            <stroke
                android:width="1dp"
                android:color="@color/vault_hairline" />
        </shape>
    </item>
</ripple>
