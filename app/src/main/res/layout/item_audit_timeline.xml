<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Timeline Spine with Dot -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="match_parent">

        <!-- Continuous vertical line -->
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@color/vault_hairline" />

        <!-- Glowing indicator dot -->
        <View
            android:id="@+id/auditDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_audit_dot" />
    </FrameLayout>

    <!-- Event Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/auditEventTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_audit_pill"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="UNLOCK_SUCCESS"
                android:textColor="@color/vault_signal_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/auditEntryId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="#42"
                android:textColor="@color/vault_emerald_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/auditTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="Oct 28, 12:45:00"
            android:textColor="@color/vault_ink_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>

