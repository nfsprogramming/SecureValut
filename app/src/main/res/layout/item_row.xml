<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_item_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Leading Tile Icon -->
    <FrameLayout
        android:id="@+id/itemTile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_tile_note">

        <ImageView
            android:id="@+id/itemIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Record Icon"
            android:src="@drawable/ic_note"
            app:tint="@color/vault_emerald_primary" />
    </FrameLayout>

    <!-- Title and Subtitle Stack -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/vault_ink_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/typeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:textColor="@color/vault_ink_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Trailing Chevron -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Open Record"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/vault_ink_muted" />
</LinearLayout>